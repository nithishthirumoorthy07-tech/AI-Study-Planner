  function seed() {
    if (Store.state.seeded || Store.state.subjects.length || Store.state.tasks.length) return;
    const offset = (n) => {
      const d = new Date();
      d.setDate(d.getDate() + n);
      return dateKey(d);
    };
    const ds = Subjects.create({ name: "Data Structures", description: "Semester core paper", color: PALETTE[0] });
    const dbms = Subjects.create({ name: "DBMS", description: "Normalization & SQL", color: PALETTE[1] });
    const apt = Subjects.create({ name: "Aptitude", description: "Placement preparation", color: PALETTE[2] });

    Tasks.create({ subjectId: ds.id, title: "Revise binary trees & traversals", description: "Inorder, preorder, postorder + practice problems.", deadline: offset(0), priority: "High", hours: 2 });
    Tasks.create({ subjectId: ds.id, title: "Solve 10 linked-list problems", description: "Focus on reversal and cycle detection.", deadline: offset(2), priority: "Medium", hours: 1.5 });
    Tasks.create({ subjectId: dbms.id, title: "Normalization assignment", description: "1NF to BCNF with examples.", deadline: offset(-1), priority: "High", hours: 1 });
    Tasks.create({ subjectId: dbms.id, title: "Practice SQL joins", description: "Inner, outer, self joins.", deadline: offset(4), priority: "Low", hours: 1 });
    Tasks.create({ subjectId: apt.id, title: "Time & work — 30 questions", description: "Timed mock set.", deadline: offset(1), priority: "Medium", hours: 1 });
    Tasks.create({ subjectId: apt.id, title: "Percentages revision", description: "Formula sheet + 20 questions.", deadline: offset(3), priority: "Low", hours: 0.5, completed: true });

    Store.state.seeded = true;
    Store.save();
  }

  /* ======================================================================
     12. EVENT WIRING
     ====================================================================== */
  function wire() {
    // Navigation ---------------------------------------------------------
    $$(".nav__link").forEach((btn) => btn.addEventListener("click", () => UI.go(btn.dataset.view)));
    $("#navToggle").addEventListener("click", () => {
      const nav = $("#primaryNav");
      const open = nav.classList.toggle("is-open");
      $("#navToggle").setAttribute("aria-expanded", String(open));
      $("#navScrim").hidden = !open;
    });
    $("#navScrim").addEventListener("click", () => {
      $("#primaryNav").classList.remove("is-open");
      $("#navScrim").hidden = true;
      $("#navToggle").setAttribute("aria-expanded", "false");
    });

    // Theme --------------------------------------------------------------
    $("#themeToggle").addEventListener("click", () =>
      SettingsUI.applyTheme(Store.state.settings.theme === "dark" ? "light" : "dark")
    );
    $$(".theme-opt").forEach((b) => b.addEventListener("click", () => SettingsUI.applyTheme(b.dataset.themeSet)));
    $("#motionToggle").addEventListener("change", (e) => SettingsUI.applyMotion(e.target.checked));

    // Create -------------------------------------------------------------
    $("#quickAddTask").addEventListener("click", () => Forms.openTask());
    $("#addTaskBtn").addEventListener("click", () => Forms.openTask());
    $("#addSubjectBtn").addEventListener("click", () => Forms.openSubject());
    $("#taskForm").addEventListener("submit", (e) => Forms.submitTask(e));
    $("#subjectForm").addEventListener("submit", (e) => Forms.submitSubject(e));
    $("#colorSwatches").addEventListener("click", (e) => {
      const sw = e.target.closest(".swatch");
      if (!sw) return;
      Forms.selectedColor = sw.dataset.color;
      $$("#colorSwatches .swatch").forEach((s) => s.classList.toggle("is-selected", s === sw));
    });

    // Modal closers ------------------------------------------------------
    $$("[data-close]").forEach((b) => b.addEventListener("click", () => UI.closeAllModals()));
    $$(".modal").forEach((m) =>
      m.addEventListener("click", (e) => { if (e.target === m) UI.closeAllModals(); })
    );

    // Task list delegation (works for every list that renders .task) -----
    document.addEventListener("click", (e) => {
      const actionBtn = e.target.closest("[data-act]");
      if (!actionBtn) return;
      const act = actionBtn.dataset.act;

      const taskEl = actionBtn.closest(".task");
      if (taskEl) {
        const id = taskEl.dataset.id;
        if (act === "toggle") {
          const t = Tasks.toggle(id);
          UI.toast(t.completed ? "Nice work — task completed!" : "Task reopened.", t.completed ? "success" : "info");
          UI.renderAll();
        } else if (act === "edit") {
          Forms.openTask(id);
        } else if (act === "delete") {
          const t = Tasks.byId(id);
          UI.confirm(`Delete "${t ? t.title : "this task"}"? This cannot be undone.`, () => {
            Tasks.remove(id);
            UI.toast("Task deleted.", "warn");
            UI.renderAll();
          });
        }
        return;
      }

      const subEl = actionBtn.closest(".subject-card");
      if (subEl) {
        const id = subEl.dataset.id;
        if (act === "edit-subject") Forms.openSubject(id);
        if (act === "delete-subject") {
          const s = Subjects.byId(id);
          UI.confirm(`Delete "${s ? s.name : "this subject"}" and all of its tasks?`, () => {
            Subjects.remove(id);
            UI.toast("Subject deleted.", "warn");
            UI.renderAll();
          });
        }
      }
    });

    // Search / filters ---------------------------------------------------
    $("#subjectSearch").addEventListener("input", debounce(() => UI.renderSubjects(), 160));
    $("#taskSearch").addEventListener("input", debounce(() => UI.renderTasks(), 160));
    ["#filterSubject", "#filterStatus", "#filterPriority", "#sortBy"].forEach((sel) =>
      $(sel).addEventListener("change", () => UI.renderTasks())
    );

    // Quick actions ------------------------------------------------------
    $$(".qa").forEach((btn) =>
      btn.addEventListener("click", () => {
        const map = {
          "add-task": () => Forms.openTask(),
          "add-subject": () => Forms.openSubject(),
          "generate-plan": () => { UI.go("planner"); UI.renderPlanner(); UI.toast("Plan regenerated.", "success"); },
          "start-pomodoro": () => { UI.go("focus"); Focus.start(); },
          "view-analytics": () => UI.go("analytics"),
          export: () => SettingsUI.exportJSON(),
        };
        (map[btn.dataset.action] || (() => {}))();
      })
    );

    // Planner ------------------------------------------------------------
    $("#regeneratePlan").addEventListener("click", () => {
      UI.renderPlanner();
      UI.toast("Schedule rebuilt from your current tasks.", "success");
    });

    // Calendar -----------------------------------------------------------
    $("#calPrev").addEventListener("click", () => { Calendar.cursor.setMonth(Calendar.cursor.getMonth() - 1); Calendar.render(); });
    $("#calNext").addEventListener("click", () => { Calendar.cursor.setMonth(Calendar.cursor.getMonth() + 1); Calendar.render(); });
    $("#calToday").addEventListener("click", () => { Calendar.cursor = new Date(); Calendar.selected = todayKey(); Calendar.render(); });
    $("#calGrid").addEventListener("click", (e) => {
      const cell = e.target.closest(".cal-cell");
      if (!cell) return;
      Calendar.selected = cell.dataset.date;
      Calendar.render();
    });

    // Focus --------------------------------------------------------------
    $("#pomoStart").addEventListener("click", () => Focus.start());
    $("#pomoPause").addEventListener("click", () => Focus.pause());
    $("#pomoReset").addEventListener("click", () => Focus.reset());
    $("#goalForm").addEventListener("submit", (e) => {
      e.preventDefault();
      Store.state.goals = {
        tasks: clamp(Number($("#goalTasks").value) || 3, 1, 20),
        hours: clamp(Number($("#goalHours").value) || 3, 1, 16),
      };
      Store.save();
      Focus.renderGoals();
      UI.renderPlanner();
      UI.toast("Daily goals saved.", "success");
    });

    // Settings -----------------------------------------------------------
    $("#exportBtn").addEventListener("click", () => SettingsUI.exportJSON());
    $("#importBtn").addEventListener("click", () => $("#importFile").click());
    $("#importFile").addEventListener("change", (e) => {
      const file = e.target.files && e.target.files[0];
      if (file) SettingsUI.importJSON(file);
      e.target.value = "";
    });
    $("#clearBtn").addEventListener("click", () =>
      UI.confirm("Erase every subject, task and setting stored in this browser?", () => {
        Store.reset();
        SettingsUI.applyTheme("dark");
        UI.renderAll();
        UI.toast("All data cleared.", "warn");
      })
    );

    // Keyboard shortcuts -------------------------------------------------
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") { UI.closeAllModals(); return; }
      const tag = (e.target.tagName || "").toLowerCase();
      if (["input", "textarea", "select"].includes(tag) || e.metaKey || e.ctrlKey || e.altKey) return;
      const k = e.key.toLowerCase();
      if (k === "n") { e.preventDefault(); Forms.openTask(); }
      else if (k === "s") { e.preventDefault(); Forms.openSubject(); }
      else if (k === "t") { SettingsUI.applyTheme(Store.state.settings.theme === "dark" ? "light" : "dark"); }
      else if (k === "g") { UI.go("planner"); UI.renderPlanner(); }
      else if (k === "p") { Focus.timer ? Focus.pause() : Focus.start(); }
      else if (k === "/") {
        e.preventDefault();
        const active = $(".view.is-active");
        const input = active ? active.querySelector('input[type="search"]') : null;
        (input || $("#taskSearch")).focus();
        if (!input) UI.go("tasks");
      }
    });

    window.addEventListener("resize", debounce(() => Analytics.chart(), 200));
    window.addEventListener("error", (e) => console.error("Runtime error:", e.message));
  }

  /* ======================================================================
     13. CLOCK
     ====================================================================== */
  function startClock() {
    const tick = () => {
      const now = new Date();
      $("#liveClock").textContent = now.toLocaleTimeString(undefined, { hour12: false });
      $("#liveDate").textContent = now.toLocaleDateString(undefined, {
        weekday: "long", day: "numeric", month: "long", year: "numeric",
      });
    };
    tick();
    setInterval(tick, 1000);
    setInterval(() => { if ($("#view-focus").classList.contains("is-active")) Focus.renderCountdowns(); }, 30000);
  }

  /* ======================================================================
     14. BOOT
     ====================================================================== */
  function init() {
    Store.load();
    seed();
    SettingsUI.applyTheme(Store.state.settings.theme || "dark");
    SettingsUI.applyMotion(!!Store.state.settings.reducedMotion);
    wire();
    UI.renderAll();
    startClock();

    const loader = $("#loader");
    setTimeout(() => {
      loader.classList.add("is-hidden");
      setTimeout(() => (loader.style.display = "none"), 450);
    }, 550);
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
  else init();

  // Expose for debugging / console use.
  window.StudyPlanner = { Store, Subjects, Tasks, Planner, Calendar, Analytics, Focus, UI };
})();
