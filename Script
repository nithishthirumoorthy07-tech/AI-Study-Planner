     ====================================================================== */
  const Calendar = {
    cursor: new Date(),
    selected: todayKey(),
    render() {
      const view = new Date(this.cursor.getFullYear(), this.cursor.getMonth(), 1);
      $("#calLabel").textContent = view.toLocaleString(undefined, { month: "long", year: "numeric" });

      // Monday-first offset
      const firstDay = (view.getDay() + 6) % 7;
      const start = new Date(view);
      start.setDate(start.getDate() - firstDay);

      const byDay = {};
      Tasks.all().forEach((t) => {
        (byDay[t.deadline] = byDay[t.deadline] || []).push(t);
      });

      let html = "";
      for (let i = 0; i < 42; i++) {
        const d = new Date(start);
        d.setDate(start.getDate() + i);
        const key = dateKey(d);
        const inMonth = d.getMonth() === view.getMonth();
        const items = byDay[key] || [];
        const dots = items
          .slice(0, 4)
          .map((t) => {
            const s = Subjects.byId(t.subjectId);
            return `<i class="cal-dot" style="background:${esc(s ? s.color : "#7c5cff")};opacity:${t.completed ? 0.35 : 1}"></i>`;
          })
          .join("");
        html += `<button type="button" role="gridcell" class="cal-cell ${inMonth ? "" : "is-muted"} ${key === todayKey() ? "is-today" : ""} ${key === this.selected ? "is-selected" : ""}"
          data-date="${key}" aria-label="${fmtDate(key)}, ${items.length} task${items.length === 1 ? "" : "s"}">
          <span class="cal-cell__n">${d.getDate()}</span>
          <span class="cal-dots">${dots}</span>
          ${items.length > 4 ? `<span class="cal-cell__more">+${items.length - 4}</span>` : ""}
        </button>`;
      }
      $("#calGrid").innerHTML = html;
      this.renderDay();
    },
    renderDay() {
      $("#dayLabel").textContent = fmtDate(this.selected);
      const items = Tasks.all().filter((t) => t.deadline === this.selected);
      $("#dayTasks").innerHTML = items.length
        ? items.map((t) => UI.taskItem(t)).join("")
        : UI.empty("No tasks on this day", "Pick another date, or add a task with this deadline.");
    },
  };

  /* ======================================================================
     7. ANALYTICS
     ====================================================================== */
  const Analytics = {
    render() {
      const s = Tasks.summary();
      $("#anaPct").textContent = `${s.pct}%`;
      $("#anaDone").textContent = s.done;
      $("#anaPending").textContent = s.pending;
      $("#anaHours").textContent = `${s.hours}h`;

      $("#subjectProgress").innerHTML = Subjects.all().length
        ? Subjects.all()
            .map((sub) => {
              const st = Subjects.stats(sub.id);
              return `<div class="sp-row" style="--sc-color:${esc(sub.color)}">
                <div class="sp-row__top"><span>${esc(sub.name)}</span><span>${st.pct}%</span></div>
                <div class="bar"><i style="width:${st.pct}%"></i></div>
              </div>`;
            })
            .join("")
        : `<p class="muted">Add subjects to see per-subject progress.</p>`;

      this.chart();
    },
    weekData() {
      const out = [];
      const now = new Date();
      const monday = new Date(now);
      monday.setDate(now.getDate() - ((now.getDay() + 6) % 7));
      for (let i = 0; i < 7; i++) {
        const d = new Date(monday);
        d.setDate(monday.getDate() + i);
        const key = dateKey(d);
        out.push({
          label: d.toLocaleDateString(undefined, { weekday: "short" }).slice(0, 3),
          value: Number(Store.state.history[key] || 0),
          isToday: key === todayKey(),
        });
      }
      return out;
    },
    chart() {
      const canvas = $("#weekChart");
      if (!canvas || !canvas.getContext) return;
      const data = this.weekData();
      const total = Math.round(data.reduce((a, b) => a + b.value, 0) * 10) / 10;
      $("#weekTotal").textContent = `${total}h`;

      const dpr = window.devicePixelRatio || 1;
      const cssW = canvas.clientWidth || 640;
      const cssH = 280;
      canvas.width = cssW * dpr;
      canvas.height = cssH * dpr;
      canvas.style.height = `${cssH}px`;

      const ctx = canvas.getContext("2d");
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cssW, cssH);

      const styles = getComputedStyle(document.body);
      const muted = styles.getPropertyValue("--text-muted").trim() || "#8b93b2";
      const grid = styles.getPropertyValue("--ring-track").trim() || "rgba(255,255,255,.1)";

      const padL = 34;
      const padB = 34;
      const padT = 16;
      const chartW = cssW - padL - 12;
      const chartH = cssH - padB - padT;
      const max = Math.max(2, Math.ceil(Math.max(...data.map((d) => d.value)) || 2));

      // grid lines + y labels
      ctx.font = "11px Manrope, sans-serif";
      ctx.fillStyle = muted;
      ctx.strokeStyle = grid;
      ctx.lineWidth = 1;
      for (let i = 0; i <= 4; i++) {
        const y = padT + (chartH / 4) * i;
        ctx.beginPath();
        ctx.moveTo(padL, y);
        ctx.lineTo(padL + chartW, y);
        ctx.stroke();
        ctx.textAlign = "right";
        ctx.fillText(String(Math.round(max - (max / 4) * i)), padL - 8, y + 4);
      }

      // bars
      const slot = chartW / data.length;
      const barW = Math.min(38, slot * 0.55);
      data.forEach((d, i) => {
        const x = padL + slot * i + (slot - barW) / 2;
        const h = (d.value / max) * chartH;
        const y = padT + chartH - h;
        const g = ctx.createLinearGradient(0, y, 0, padT + chartH);
        g.addColorStop(0, d.isToday ? "#22d3ee" : "#7c5cff");
        g.addColorStop(1, d.isToday ? "#7c5cff" : "#f472b6");
        ctx.fillStyle = g;
        const r = Math.min(8, barW / 2, Math.max(0, h));
        ctx.beginPath();
        ctx.moveTo(x, padT + chartH);
        ctx.lineTo(x, y + r);
        ctx.quadraticCurveTo(x, y, x + r, y);
        ctx.lineTo(x + barW - r, y);
        ctx.quadraticCurveTo(x + barW, y, x + barW, y + r);
        ctx.lineTo(x + barW, padT + chartH);
        ctx.closePath();
        ctx.fill();

        ctx.fillStyle = muted;
        ctx.textAlign = "center";
        ctx.fillText(d.label, x + barW / 2, cssH - 12);
        if (d.value > 0) {
          ctx.fillText(`${d.value}h`, x + barW / 2, y - 6);
        }
      });
    },
  };

  /* ======================================================================
     8. FOCUS — Pomodoro, countdowns, goals
     ====================================================================== */
  const Focus = {
    WORK: 25 * 60,
    BREAK: 5 * 60,
    mode: "Focus",
    remaining: 25 * 60,
    timer: null,

    render() {
      this.rollDay();
      $("#pomoCount").textContent = Store.state.pomodoro.count;
      $("#goalTasks").value = Store.state.goals.tasks;
      $("#goalHours").value = Store.state.goals.hours;
      this.paint();
      this.renderCountdowns();
      this.renderGoals();
    },
    rollDay() {
      const p = Store.state.pomodoro;
      if (p.date !== todayKey()) {
        p.date = todayKey();
        p.count = 0;
        Store.save();
      }
    },
    paint() {
      const total = this.mode === "Focus" ? this.WORK : this.BREAK;
      const mm = String(Math.floor(this.remaining / 60)).padStart(2, "0");
      const ss = String(this.remaining % 60).padStart(2, "0");
      $("#pomoTime").textContent = `${mm}:${ss}`;
      $("#pomoMode").textContent = this.mode;
      const c = 2 * Math.PI * 88;
      $("#pomoRing").style.strokeDasharray = String(c);
      $("#pomoRing").style.strokeDashoffset = String(c * (1 - this.remaining / total));
      document.title = this.timer ? `${mm}:${ss} · ${this.mode} — AI Study Planner` : "AI Study Planner — Smart Dashboard for Students";
    },
    start() {
      if (this.timer) return;
      this.timer = setInterval(() => {
        this.remaining -= 1;
        if (this.remaining <= 0) this.complete();
        this.paint();
      }, 1000);
      UI.toast(`${this.mode} session started.`, "success");
      this.paint();
    },
    pause() {
      clearInterval(this.timer);
      this.timer = null;
      this.paint();
      UI.toast("Timer paused.", "warn");
    },
    reset() {
      clearInterval(this.timer);
      this.timer = null;
      this.remaining = this.mode === "Focus" ? this.WORK : this.BREAK;
      this.paint();
    },
    complete() {
      clearInterval(this.timer);
      this.timer = null;
      if (this.mode === "Focus") {
        Store.state.pomodoro.count += 1;
        Store.save();
        $("#pomoCount").textContent = Store.state.pomodoro.count;
        this.mode = "Break";
        this.remaining = this.BREAK;
        UI.toast("Focus session done — take a 5 minute break.", "success", 5000);
      } else {
        this.mode = "Focus";
        this.remaining = this.WORK;
        UI.toast("Break over. Ready for the next block?", "info", 5000);
      }
      this.paint();
    },
    renderCountdowns() {
      const list = Tasks.all()
        .filter((t) => !t.completed)
        .sort((a, b) => a.deadline.localeCompare(b.deadline))
        .slice(0, 5);
      $("#countdowns").innerHTML = list.length
        ? list
            .map((t) => {
              const ms = new Date(`${t.deadline}T23:59:59`) - new Date();
              const late = ms < 0;
              const abs = Math.abs(ms);
              const d = Math.floor(abs / 86400000);
              const h = Math.floor((abs % 86400000) / 3600000);
              const m = Math.floor((abs % 3600000) / 60000);
              return `<div class="countdown"><span>${esc(t.title)}</span>
                <span class="countdown__time ${late ? "is-late" : ""}">${late ? "-" : ""}${d}d ${h}h ${m}m</span></div>`;
            })
            .join("")
        : `<p class="muted">No pending deadlines. Beautiful.</p>`;
    },
    renderGoals() {
      const goals = Store.state.goals;
      const doneToday = Tasks.all().filter(
        (t) => t.completed && t.completedAt && dateKey(new Date(t.completedAt)) === todayKey()
      ).length;
      const hoursToday = Number(Store.state.history[todayKey()] || 0);
      const row = (label, value, target, unit) => {
        const pct = clamp(Math.round((value / (target || 1)) * 100), 0, 100);
        return `<div class="sp-row" style="--sc-color:var(--brand-2)">
          <div class="sp-row__top"><span>${label}</span><span>${value}${unit} / ${target}${unit}</span></div>
          <div class="bar"><i style="width:${pct}%"></i></div>
        </div>`;
      };
      $("#goalProgress").innerHTML =
        row("Tasks completed", doneToday, goals.tasks, "") + row("Study hours logged", hoursToday, goals.hours, "h");
    },
  };

