  const SettingsUI = {
    applyTheme(theme) {
      document.documentElement.dataset.theme = theme;
      Store.state.settings.theme = theme;
      Store.save();
      $$(".theme-opt").forEach((b) => b.setAttribute("aria-checked", String(b.dataset.themeSet === theme)));
      Analytics.chart();
    },
    applyMotion(reduced) {
      document.documentElement.dataset.motion = reduced ? "reduced" : "full";
      Store.state.settings.reducedMotion = reduced;
      Store.save();
    },
    render() {
      $$(".theme-opt").forEach((b) =>
        b.setAttribute("aria-checked", String(b.dataset.themeSet === Store.state.settings.theme))
      );
      $("#motionToggle").checked = !!Store.state.settings.reducedMotion;
      $("#metaSubjects").textContent = Subjects.all().length;
      $("#metaTasks").textContent = Tasks.all().length;
      $("#metaSize").textContent = `${(Store.bytes() / 1024).toFixed(1)} KB`;
    },
    exportJSON() {
      try {
        const blob = new Blob([JSON.stringify(Store.state, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `ai-study-planner-${todayKey()}.json`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
        UI.toast("Backup exported.", "success");
      } catch (err) {
        console.error(err);
        UI.toast("Export failed.", "error");
      }
    },
    importJSON(file) {
      const reader = new FileReader();
      reader.onload = () => {
        try {
          const data = JSON.parse(String(reader.result));
          if (!data || !Array.isArray(data.tasks) || !Array.isArray(data.subjects)) {
            throw new Error("Unexpected file shape");
          }
          Store.replace(data);
          this.applyTheme(Store.state.settings.theme || "dark");
          UI.renderAll();
          UI.toast("Backup imported successfully.", "success");
        } catch (err) {
          console.error(err);
          UI.toast("That file isn't a valid planner backup.", "error");
        }
      };
      reader.onerror = () => UI.toast("Could not read the file.", "error");
      reader.readAsText(file);
    },
  };

