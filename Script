/* =========================================================================
   AI Study Planner — script.js
   Vanilla ES6, no dependencies. Architecture:
     Store      -> LocalStorage persistence + schema versioning
     Subjects   -> subject CRUD
     Tasks      -> task CRUD, search / filter / sort
     Planner    -> rule-based "AI" scheduling engine
     Calendar   -> month grid rendering
     Analytics  -> stats + canvas chart
     Focus      -> Pomodoro, countdowns, daily goals
     Settings   -> theme, export / import / reset
     UI         -> routing, modals, toasts, shortcuts, rendering glue
   ========================================================================= */
(function () {
  "use strict";

  /* ======================================================================
     0. UTILITIES
     ====================================================================== */
  const $ = (sel, root = document) => root.querySelector(sel);
  const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));

  /** Escape user text before injecting into innerHTML. */
  const esc = (str) =>
    String(str == null ? "" : str).replace(/[&<>"']/g, (c) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;",
    })[c]);

  const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 8);

  /** Local (not UTC) YYYY-MM-DD key for a Date. */
  const dateKey = (d) => {
    const x = new Date(d);
    return `${x.getFullYear()}-${String(x.getMonth() + 1).padStart(2, "0")}-${String(x.getDate()).padStart(2, "0")}`;
  };

  const todayKey = () => dateKey(new Date());

  /** Whole-day difference between two YYYY-MM-DD keys (b - a). */
  const daysBetween = (aKey, bKey) => {
    const a = new Date(`${aKey}T00:00:00`);
    const b = new Date(`${bKey}T00:00:00`);
    return Math.round((b - a) / 86400000);
  };

  const fmtDate = (key) =>
    new Date(`${key}T00:00:00`).toLocaleDateString(undefined, {
      weekday: "short",
      day: "numeric",
      month: "short",
    });

  const clamp = (n, min, max) => Math.min(max, Math.max(min, n));

  const debounce = (fn, wait = 200) => {
    let t;
    return (...args) => {
      clearTimeout(t);
      t = setTimeout(() => fn(...args), wait);
    };
  };

  const PRIORITY_WEIGHT = { High: 3, Medium: 2, Low: 1 };

  const PALETTE = [
    "#7c5cff", "#22d3ee", "#f472b6", "#34d399",
    "#fbbf24", "#fb7185", "#60a5fa", "#a3e635",
  ];

  const QUOTES = [
    "Small daily improvements are the key to staggering long-term results.",
    "Discipline is choosing between what you want now and what you want most.",
    "You don't have to be extreme, just consistent.",
    "The expert in anything was once a beginner who refused to quit.",
    "Focus is saying no to a hundred good ideas.",
    "Study while others sleep; work while others loaf.",
    "Progress, not perfection, compounds.",
  ];

  const TIP_POOL = [
    "Start with the hardest task while your focus is freshest.",
    "Batch similar subjects together to reduce context switching.",
    "Take a real 5-minute break — screens don't count as rest.",
    "Review yesterday's notes for 5 minutes before starting new material.",
    "Write down one sentence about what you learned after each session.",
    "Hydrate and stand up between Pomodoros; your brain runs on blood flow.",
  ];

  /* ======================================================================
     1. STORE — LocalStorage persistence
     ====================================================================== */
  const Store = (() => {
    const KEY = "aiStudyPlanner.v1";

    const defaults = () => ({
      version: 1,
      subjects: [],
      tasks: [],
      settings: { theme: "dark", reducedMotion: false },
      goals: { tasks: 3, hours: 3 },
      pomodoro: { date: todayKey(), count: 0 },
      streak: { current: 0, lastDay: null },
      history: {}, // { 'YYYY-MM-DD': hoursCompleted }
      seeded: false,
    });

    let state = defaults();

    function load() {
      try {
        const raw = localStorage.getItem(KEY);
        if (!raw) return;
        const parsed = JSON.parse(raw);
        if (parsed && typeof parsed === "object") {
          state = Object.assign(defaults(), parsed);
          state.settings = Object.assign(defaults().settings, parsed.settings || {});
          state.goals = Object.assign(defaults().goals, parsed.goals || {});
          state.pomodoro = Object.assign(defaults().pomodoro, parsed.pomodoro || {});
          state.streak = Object.assign(defaults().streak, parsed.streak || {});
          state.history = parsed.history || {};
        }
      } catch (err) {
        console.error("Failed to read saved data:", err);
        UI.toast("Saved data was corrupted — starting fresh.", "error");
        state = defaults();
      }
    }

    function save() {
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch (err) {
        console.error("Failed to save:", err);
        UI.toast("Could not save — storage may be full.", "error");
      }
    }

    return {
      load,
      save,
      get state() { return state; },
      replace(next) { state = Object.assign(defaults(), next); save(); },
      reset() { state = defaults(); save(); },
      bytes() {
        try { return (localStorage.getItem(KEY) || "").length; } catch { return 0; }
      },
    };
  })();

  /* ======================================================================
     2. SUBJECTS
     ====================================================================== */
  const Subjects = {
    all() { return Store.state.subjects; },
    byId(id) { return Store.state.subjects.find((s) => s.id === id) || null; },
    nextColor() {
      const used = Store.state.subjects.map((s) => s.color);
      return PALETTE.find((c) => !used.includes(c)) || PALETTE[used.length % PALETTE.length];
    },
    create({ name, description, color }) {
      const subject = {
        id: uid(),
        name: name.trim(),
        description: (description || "").trim(),
        color: color || this.nextColor(),
        createdAt: Date.now(),
      };
      Store.state.subjects.push(subject);
      Store.save();
      return subject;
    },
    update(id, patch) {
      const s = this.byId(id);
      if (!s) return null;
      Object.assign(s, patch);
      Store.save();
      return s;
    },
    remove(id) {
      Store.state.subjects = Store.state.subjects.filter((s) => s.id !== id);
      // Cascade: drop tasks that belonged to the subject.
      Store.state.tasks = Store.state.tasks.filter((t) => t.subjectId !== id);
      Store.save();
    },
    search(term) {
      const q = (term || "").trim().toLowerCase();
      if (!q) return this.all();
      return this.all().filter(
        (s) => s.name.toLowerCase().includes(q) || (s.description || "").toLowerCase().includes(q)
      );
    },
    stats(id) {
      const tasks = Tasks.all().filter((t) => t.subjectId === id);
      const done = tasks.filter((t) => t.completed).length;
      return {
        total: tasks.length,
        done,
        pct: tasks.length ? Math.round((done / tasks.length) * 100) : 0,
        hours: tasks.reduce((sum, t) => sum + Number(t.hours || 0), 0),
      };
    },
  };

  /* ======================================================================
     3. TASKS
     ====================================================================== */
  const Tasks = {
    all() { return Store.state.tasks; },
    byId(id) { return Store.state.tasks.find((t) => t.id === id) || null; },
    create(data) {
      const task = {
        id: uid(),
        subjectId: data.subjectId,
        title: data.title.trim(),
        description: (data.description || "").trim(),
        deadline: data.deadline,
        priority: data.priority || "Medium",
        hours: Number(data.hours) || 1,
        completed: !!data.completed,
        createdAt: Date.now(),
        completedAt: data.completed ? Date.now() : null,
      };
      Store.state.tasks.push(task);
      Store.save();
      return task;
    },
    update(id, patch) {
      const t = this.byId(id);
      if (!t) return null;
      const wasDone = t.completed;
      Object.assign(t, patch);
      if (!wasDone && t.completed) this.registerCompletion(t);
      if (wasDone && !t.completed) t.completedAt = null;
      Store.save();
      return t;
    },
    remove(id) {
      Store.state.tasks = Store.state.tasks.filter((t) => t.id !== id);
      Store.save();
    },
    toggle(id) {
      const t = this.byId(id);
      if (!t) return null;
      t.completed = !t.completed;
      if (t.completed) this.registerCompletion(t);
      else t.completedAt = null;
      Store.save();
      return t;
    },
    /** Record completion time, study history and daily streak. */
    registerCompletion(task) {
      task.completedAt = Date.now();
      const key = todayKey();
      const hist = Store.state.history;
      hist[key] = Math.round(((hist[key] || 0) + Number(task.hours || 0)) * 100) / 100;

      const streak = Store.state.streak;
      if (streak.lastDay !== key) {
        const gap = streak.lastDay ? daysBetween(streak.lastDay, key) : null;
        streak.current = gap === 1 ? streak.current + 1 : 1;
        streak.lastDay = key;
      }
    },
    isOverdue(t) { return !t.completed && daysBetween(todayKey(), t.deadline) < 0; },
    isToday(t) { return t.deadline === todayKey(); },
    query({ search = "", subject = "all", status = "all", priority = "all", sort = "deadline" } = {}) {
      const q = search.trim().toLowerCase();
      let list = this.all().filter((t) => {
        if (q && !(t.title.toLowerCase().includes(q) || (t.description || "").toLowerCase().includes(q))) return false;
        if (subject !== "all" && t.subjectId !== subject) return false;
        if (priority !== "all" && t.priority !== priority) return false;
        if (status === "pending" && t.completed) return false;
        if (status === "completed" && !t.completed) return false;
        if (status === "overdue" && !this.isOverdue(t)) return false;
        return true;
      });

      const sorters = {
        deadline: (a, b) => a.deadline.localeCompare(b.deadline),
        priority: (a, b) => PRIORITY_WEIGHT[b.priority] - PRIORITY_WEIGHT[a.priority],
        title: (a, b) => a.title.localeCompare(b.title),
        created: (a, b) => b.createdAt - a.createdAt,
        duration: (a, b) => b.hours - a.hours,
      };
      list = list.slice().sort(sorters[sort] || sorters.deadline);
      // Completed tasks always sink to the bottom for readability.
      return list.sort((a, b) => Number(a.completed) - Number(b.completed));
    },
    summary() {
      const all = this.all();
      const done = all.filter((t) => t.completed).length;
      return {
        total: all.length,
        done,
        pending: all.length - done,
        overdue: all.filter((t) => this.isOverdue(t)).length,
        pct: all.length ? Math.round((done / all.length) * 100) : 0,
        hours: Math.round(all.reduce((s, t) => s + Number(t.hours || 0), 0) * 10) / 10,
      };
    },
  };

  /* ======================================================================
     4. PLANNER — simulated AI scheduling (pure heuristics, no network)
     ====================================================================== */
  const Planner = {
    /**
     * Score = priority weight + urgency + overdue penalty + effort bonus.
     * Higher score means "do this sooner".
     */
    score(task) {
      const days = daysBetween(todayKey(), task.deadline);
      let s = PRIORITY_WEIGHT[task.priority] * 12;
      if (days < 0) s += 60 + Math.min(Math.abs(days), 10) * 4; // overdue dominates
      else if (days === 0) s += 45;
      else s += clamp(30 - days * 3, 0, 30);
      s += clamp(Number(task.hours || 1), 0, 6); // longer work gets a nudge earlier
      return Math.round(s);
    },
    ranked() {
      return Tasks.all()
        .filter((t) => !t.completed)
        .map((t) => ({ task: t, score: this.score(t) }))
        .sort((a, b) => b.score - a.score);
    },
    /** Build a time-boxed schedule for today, capped at the daily hour goal + buffer. */
    schedule() {
      const cap = clamp(Number(Store.state.goals.hours) || 3, 1, 12);
      const ranked = this.ranked();
      const slots = [];
      let cursor = this.startHour();
      let used = 0;

      for (const { task, score } of ranked) {
        if (used >= cap) break;
        const block = Math.min(Number(task.hours || 1), Math.max(0.5, cap - used));
        slots.push({
          type: "study",
          start: cursor,
          end: cursor + block,
          task,
          score,
          reason: this.reason(task),
        });
        used += block;
        cursor += block;
        if (used < cap) {
          slots.push({ type: "break", start: cursor, end: cursor + 0.25 });
          cursor += 0.25;
        }
      }
      return { slots, used: Math.round(used * 10) / 10, cap };
    },
    startHour() {
      const now = new Date();
      const h = now.getHours() + (now.getMinutes() > 30 ? 1 : 0.5);
      return clamp(Math.max(h, 8), 8, 21);
    },
    reason(task) {
      const days = daysBetween(todayKey(), task.deadline);
      if (days < 0) return `Overdue by ${Math.abs(days)} day${Math.abs(days) === 1 ? "" : "s"}`;
      if (days === 0) return "Due today";
      if (task.priority === "High") return `High priority · due in ${days}d`;
      return `Due in ${days} day${days === 1 ? "" : "s"}`;
    },
    pomodoros() {
      const { slots } = this.schedule();
      return slots
        .filter((s) => s.type === "study")
        .map((s) => ({
          title: s.task.title,
          sessions: Math.max(1, Math.round((s.end - s.start) / 0.5)),
        }));
    },
    tips() {
      const s = Tasks.summary();
      const out = [];
      if (s.total === 0) out.push("Add your first subject and task — the planner builds a schedule instantly.");
      if (s.overdue > 0) out.push(`You have ${s.overdue} overdue task${s.overdue === 1 ? "" : "s"}. Clear the oldest one first to stop the snowball.`);
      const high = Tasks.all().filter((t) => !t.completed && t.priority === "High").length;
      if (high > 3) out.push("More than three High-priority tasks: consider demoting the least urgent to Medium.");
      if (s.pct >= 70 && s.total > 0) out.push(`You're ${s.pct}% done overall — excellent pace, protect your streak today.`);
      if (Store.state.streak.current >= 3) out.push(`${Store.state.streak.current}-day streak. Ten focused minutes keeps it alive.`);
      out.push(TIP_POOL[new Date().getDate() % TIP_POOL.length]);
      return out.slice(0, 4);
    },
  };

  /* ======================================================================
     5. UI — toasts, modals, routing, rendering
     ====================================================================== */
  const UI = {
    /* --------------------------- toasts ------------------------------- */
    toast(message, type = "info", ttl = 3200) {
      const host = $("#toasts");
      if (!host) return;
      const el = document.createElement("div");
      el.className = `toast toast--${type}`;
      el.textContent = message;
      host.appendChild(el);
      setTimeout(() => {
        el.classList.add("is-out");
        setTimeout(() => el.remove(), 280);
      }, ttl);
    },

    /* --------------------------- modals ------------------------------- */
    openModal(id) {
      const m = document.getElementById(id);
      if (!m) return;
      m.hidden = false;
      this._lastFocus = document.activeElement;
      const focusable = m.querySelector("input, select, textarea, button");
      if (focusable) setTimeout(() => focusable.focus(), 40);
    },
    closeModal(id) {
      const m = document.getElementById(id);
      if (!m) return;
      m.hidden = true;
      if (this._lastFocus && this._lastFocus.focus) this._lastFocus.focus();
    },
    closeAllModals() { $$(".modal").forEach((m) => (m.hidden = true)); },

    confirm(text, onOk) {
      $("#confirmText").textContent = text;
      this.openModal("confirmModal");
      const btn = $("#confirmOk");
      const clone = btn.cloneNode(true); // drop previous listeners
      btn.replaceWith(clone);
      clone.addEventListener("click", () => {
        this.closeModal("confirmModal");
        onOk();
      });
    },

    /* --------------------------- routing ------------------------------ */
    go(view) {
      $$(".view").forEach((v) => v.classList.toggle("is-active", v.id === `view-${view}`));
      $$(".nav__link").forEach((b) => b.classList.toggle("is-active", b.dataset.view === view));
      $("#primaryNav").classList.remove("is-open");
      $("#navScrim").hidden = true;
      $("#navToggle").setAttribute("aria-expanded", "false");
      window.scrollTo({ top: 0, behavior: "smooth" });
      if (view === "analytics") Analytics.render();
      if (view === "calendar") Calendar.render();
      if (view === "planner") UI.renderPlanner();
      if (view === "focus") Focus.render();
      if (view === "settings") SettingsUI.render();
    },

    /* -------------------------- fragments ----------------------------- */
    empty(title, body) {
      return `<li class="empty">
        <svg viewBox="0 0 200 130" aria-hidden="true">
          <rect x="26" y="26" width="148" height="86" rx="14" fill="none" stroke="currentColor" stroke-width="3" opacity=".45"/>
          <path d="M48 58h72M48 76h52" stroke="currentColor" stroke-width="6" stroke-linecap="round" opacity=".35"/>
          <circle cx="152" cy="94" r="17" fill="none" stroke="currentColor" stroke-width="3"/>
          <path d="M152 86v16M144 94h16" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
        </svg>
        <strong>${esc(title)}</strong>
        <p>${esc(body)}</p>
      </li>`;
    },

    taskItem(task) {
      const subject = Subjects.byId(task.subjectId);
      const overdue = Tasks.isOverdue(task);
      const days = daysBetween(todayKey(), task.deadline);
      const when = overdue
        ? `Overdue ${Math.abs(days)}d`
        : days === 0
          ? "Due today"
          : days === 1
            ? "Due tomorrow"
            : fmtDate(task.deadline);
      return `<li class="task ${task.completed ? "is-done" : ""} ${overdue ? "is-overdue" : ""}" data-id="${task.id}">
        <button class="task__check" data-act="toggle" aria-label="${task.completed ? "Mark as pending" : "Mark as complete"}" aria-pressed="${task.completed}">
          <svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>
        </button>
        <div class="task__body">
          <div class="task__title">${esc(task.title)}</div>
          ${task.description ? `<p class="task__desc">${esc(task.description)}</p>` : ""}
          <div class="task__meta">
            <span class="tag tag--subject"><i class="tag__dot" style="background:${esc(subject ? subject.color : "#7c5cff")}"></i>${esc(subject ? subject.name : "No subject")}</span>
            <span class="tag tag--${esc(task.priority)}">${esc(task.priority)}</span>
            <span class="tag ${overdue ? "tag--danger" : ""}">${esc(when)}</span>
            <span class="tag">${esc(task.hours)}h</span>
          </div>
        </div>
        <div class="task__actions">
          <button class="mini-btn" data-act="edit" aria-label="Edit ${esc(task.title)}"><svg class="icon" aria-hidden="true"><use href="#i-edit"/></svg></button>
          <button class="mini-btn mini-btn--danger" data-act="delete" aria-label="Delete ${esc(task.title)}"><svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg></button>
        </div>
      </li>`;
    },

    /* --------------------------- renderers ---------------------------- */
    renderAll() {
      this.renderDashboard();
      this.renderSubjects();
      this.renderTasks();
      this.renderPlanner();
      Calendar.render();
      Analytics.render();
      Focus.render();
      SettingsUI.render();
      this.syncSubjectSelects();
    },

    renderDashboard() {
      const s = Tasks.summary();
      $("#statTotal").textContent = s.total;
      $("#statDone").textContent = s.done;
      $("#statPending").textContent = s.pending;
      $("#statOverdue").textContent = s.overdue;
      $("#statStreak").textContent = Store.state.streak.current;
      $("#progressPct").textContent = `${s.pct}%`;

      const ring = $("#progressRing");
      const circumference = 2 * Math.PI * 52;
      ring.style.strokeDasharray = String(circumference);
      ring.style.strokeDashoffset = String(circumference * (1 - s.pct / 100));

      // Today's tasks
      const today = Tasks.all()
        .filter((t) => Tasks.isToday(t) || Tasks.isOverdue(t))
        .sort((a, b) => Planner.score(b) - Planner.score(a));
      $("#todayCount").textContent = today.length;
      $("#todayList").innerHTML = today.length
        ? today.map((t) => this.taskItem(t)).join("")
        : this.empty("Nothing due today", "Enjoy the breathing room, or pull a task forward from the planner.");

      // Upcoming deadlines
      const upcoming = Tasks.all()
        .filter((t) => !t.completed && daysBetween(todayKey(), t.deadline) > 0)
        .sort((a, b) => a.deadline.localeCompare(b.deadline))
        .slice(0, 6);
      $("#deadlineCount").textContent = upcoming.length;
      $("#deadlineList").innerHTML = upcoming.length
        ? upcoming
            .map((t) => {
              const d = new Date(`${t.deadline}T00:00:00`);
              const subject = Subjects.byId(t.subjectId);
              const left = daysBetween(todayKey(), t.deadline);
              return `<li class="deadline">
                <div class="deadline__date"><b>${d.getDate()}</b><span>${d.toLocaleString(undefined, { month: "short" })}</span></div>
                <div class="deadline__info">
                  <div class="deadline__title">${esc(t.title)}</div>
                  <div class="deadline__sub">${esc(subject ? subject.name : "No subject")} · ${esc(t.priority)}</div>
                </div>
                <div class="deadline__left">in ${left}d</div>
              </li>`;
            })
            .join("")
        : `<li class="empty"><strong>No upcoming deadlines</strong><p>Add tasks with due dates to see them here.</p></li>`;

      // Greeting + quote
      const h = new Date().getHours();
      $("#greeting").textContent = h < 12 ? "Good morning" : h < 17 ? "Good afternoon" : h < 21 ? "Good evening" : "Burning the midnight oil";
      $("#dailyQuote").textContent = `"${QUOTES[new Date().getDate() % QUOTES.length]}"`;
    },

    renderSubjects() {
      const term = $("#subjectSearch").value;
      const list = Subjects.search(term);
      const host = $("#subjectGrid");
      if (!list.length) {
        host.innerHTML = `<div class="panel glass"><ul>${this.empty(
          term ? "No matching subjects" : "No subjects yet",
          term ? "Try a different search term." : "Create a subject to start organising your tasks."
        )}</ul></div>`;
        return;
      }
      host.innerHTML = list
        .map((s) => {
          const st = Subjects.stats(s.id);
          return `<article class="subject-card" style="--sc-color:${esc(s.color)}" data-id="${s.id}">
            <div class="subject-card__top">
              <div>
                <div class="subject-card__name">${esc(s.name)}</div>
                <div class="subject-card__desc">${esc(s.description || "—")}</div>
              </div>
              <div class="task__actions">
                <button class="mini-btn" data-act="edit-subject" aria-label="Edit ${esc(s.name)}"><svg class="icon" aria-hidden="true"><use href="#i-edit"/></svg></button>
                <button class="mini-btn mini-btn--danger" data-act="delete-subject" aria-label="Delete ${esc(s.name)}"><svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg></button>
              </div>
            </div>
            <div class="subject-card__stats"><span>${st.done}/${st.total} done</span><span>${st.hours}h planned</span><span>${st.pct}%</span></div>
            <div class="bar"><i style="width:${st.pct}%"></i></div>
          </article>`;
        })
        .join("");
    },

    renderTasks() {
      const list = Tasks.query({
        search: $("#taskSearch").value,
        subject: $("#filterSubject").value,
        status: $("#filterStatus").value,
        priority: $("#filterPriority").value,
        sort: $("#sortBy").value,
      });
      $("#taskList").innerHTML = list.length
        ? list.map((t) => this.taskItem(t)).join("")
        : this.empty("No tasks match", "Adjust your filters, or add a new task to get going.");
    },

    renderPlanner() {
      const { slots, used } = Planner.schedule();
      $("#planLoad").textContent = `${used}h`;
      const fmtH = (v) => {
        const hh = Math.floor(v) % 24;
        const mm = Math.round((v % 1) * 60);
        return `${String(hh).padStart(2, "0")}:${String(mm).padStart(2, "0")}`;
      };
      $("#scheduleList").innerHTML = slots.length
        ? slots
            .map((s) =>
              s.type === "break"
