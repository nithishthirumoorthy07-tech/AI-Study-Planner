  const Forms = {
    selectedColor: PALETTE[0],

    openTask(id) {
      if (!Subjects.all().length) {
        UI.toast("Create a subject before adding tasks.", "warn");
        this.openSubject();
        return;
      }
      UI.syncSubjectSelects();
      $$("[data-err]").forEach((e) => (e.textContent = ""));
      const t = id ? Tasks.byId(id) : null;
      $("#taskModalTitle").textContent = t ? "Edit task" : "New task";
      $("#taskId").value = t ? t.id : "";
      $("#taskTitle").value = t ? t.title : "";
      $("#taskSubject").value = t ? t.subjectId : Subjects.all()[0].id;
      $("#taskDesc").value = t ? t.description : "";
      $("#taskDeadline").value = t ? t.deadline : todayKey();
      $("#taskPriority").value = t ? t.priority : "Medium";
      $("#taskHours").value = t ? t.hours : 1;
      $("#taskDone").checked = t ? t.completed : false;
      UI.openModal("taskModal");
    },

    submitTask(e) {
      e.preventDefault();
      const title = $("#taskTitle").value.trim();
      const subjectId = $("#taskSubject").value;
      const deadline = $("#taskDeadline").value;
      let ok = true;
      $$("[data-err]").forEach((el) => (el.textContent = ""));
      if (!title) { $('[data-err="taskTitle"]').textContent = "Give the task a title."; ok = false; }
      if (!subjectId) { $('[data-err="taskSubject"]').textContent = "Pick a subject."; ok = false; }
      if (!deadline) { $('[data-err="taskDeadline"]').textContent = "Choose a deadline."; ok = false; }
      if (!ok) return;

      const payload = {
        title,
        subjectId,
        deadline,
        description: $("#taskDesc").value,
        priority: $("#taskPriority").value,
        hours: clamp(Number($("#taskHours").value) || 1, 0.5, 12),
        completed: $("#taskDone").checked,
      };
      const id = $("#taskId").value;
      if (id) {
        Tasks.update(id, payload);
        UI.toast("Task updated.", "success");
      } else {
        Tasks.create(payload);
        UI.toast("Task added.", "success");
      }
      UI.closeModal("taskModal");
      UI.renderAll();
    },

    openSubject(id) {
      $$("[data-err]").forEach((e) => (e.textContent = ""));
      const s = id ? Subjects.byId(id) : null;
      $("#subjectModalTitle").textContent = s ? "Edit subject" : "New subject";
      $("#subjectId").value = s ? s.id : "";
      $("#subjectName").value = s ? s.name : "";
      $("#subjectDesc").value = s ? s.description : "";
      this.selectedColor = s ? s.color : Subjects.nextColor();
      $("#colorSwatches").innerHTML = PALETTE.map(
        (c) => `<button type="button" class="swatch ${c === this.selectedColor ? "is-selected" : ""}" data-color="${c}" style="background:${c}" aria-label="Colour ${c}"></button>`
      ).join("");
      UI.openModal("subjectModal");
    },

    submitSubject(e) {
      e.preventDefault();
      const name = $("#subjectName").value.trim();
      $$("[data-err]").forEach((el) => (el.textContent = ""));
      if (!name) {
        $('[data-err="subjectName"]').textContent = "Give the subject a name.";
        return;
      }
      const payload = { name, description: $("#subjectDesc").value, color: this.selectedColor };
      const id = $("#subjectId").value;
      if (id) {
        Subjects.update(id, payload);
        UI.toast("Subject updated.", "success");
      } else {
        Subjects.create(payload);
        UI.toast("Subject added.", "success");
      }
      UI.closeModal("subjectModal");
      UI.renderAll();
    },
  };

